NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pinggo
DB_USER=pinggo
DB_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars

# Access token lifetime and refresh policy (see src/config/index.js)
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_GRACE_SECONDS=604800
SESSION_MAX_AGE_SECONDS=2592000

# Skylab token exchange — server-to-server validation of the opaque Labit session token.
# Required when NODE_ENV=production. PinGGo POSTs {"token": "<skylabToken>", ...EXTRA_BODY}
# as JSON and reads the contact id at LABIT_CONTACT_ID_PATH; it must equal skylabId.
LABIT_VALIDATE_URL=
LABIT_VALIDATE_EXTRA_BODY=
LABIT_CONTACT_ID_PATH=contact_id
LABIT_VALIDATE_TIMEOUT_MS=5000

# AWS S3 (used for file uploads — optional in dev)
S3_BUCKET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Attachments and previews (all optional; defaults shown)
# Uploads go browser → S3 directly, so a large cap costs the server nothing.
UPLOAD_MAX_MB=1024
# Above this size files still upload/download, but get no thumbnail or Office preview.
PREVIEW_MAX_SOURCE_MB=300
LIBREOFFICE_TIMEOUT_MS=240000
PDFTOPPM_TIMEOUT_MS=60000
# Simultaneous LibreOffice/pdftoppm processes (a big deck can take ~1 GB of RAM).
CONVERSION_CONCURRENCY=2
PREVIEW_FAILURE_TTL_SECONDS=21600
